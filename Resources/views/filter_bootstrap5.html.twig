{% trans_default_domain "datatables" %}

{% block text_filter_widget %}

    {% set grouped = filter_options.empty is defined and filter_options.empty %}

    {% if grouped %}
    <div class="input-group input-group-sm">
    {% endif %}

    <input type="text" class="form-control form-control-sm datatables-filter-input" placeholder="{{ column.placeholder | trans }}" {{ block('widget_attributes') }} autocomplete="off">

    {% if grouped %}
    <span class="input-group-text">
        <input type="checkbox" id="{{ id }}_empty" class="datatables-filter-input">
    </span>
    {% endif %}

    {% if grouped %}
    </div>
    {% endif %}
{% endblock text_filter_widget %}

{% block date_filter_widget %}
    {% set input %}
        <input type="text" class="form-control form-control-sm datatables-filter-input" placeholder="{{ column.placeholder | trans }}" {{ block('widget_attributes') }} autocomplete="off">
    {% endset %}

    <a class="btn btn-outline-secondary" tabindex="-1" data-container="body" data-toggle="popover" data-placement="bottom" data-html="true" data-content="{{ input | e }}">
        &#x2026;
    </a>
{% endblock date_filter_widget %}

{% block choice_filter_widget %}
    <select title="{{ column.label }}" class="form-select form-select-sm datatables-filter-input"{% if filter_options.multiple %} multiple="multiple"{% endif %} {{ block('widget_attributes') }}>
        {% if not filter_options.multiple %}
            <option value="">{{ 'select all' | trans }}</option>
        {% endif %}

        {% for key, label in filter_options.choices %}
            <option value="{{ key }}">{{ label | trans }}</option>
        {% endfor %}
    </select>
{% endblock choice_filter_widget %}


{% block filter_widget %}
    filter widget
{% endblock filter_widget %}

{%- block widget_attributes -%}
    id="{{ id }}" {#name="{{ full_name }}"
    {%- if disabled %} disabled="disabled"{% endif -%}
    {%- if required %} required="required"{% endif -%}#}
    {{ block('attributes') }}
{%- endblock widget_attributes -%}

{% block attributes -%}
    {%- for attrname, attrvalue in filter_options.attr -%}
        {{- " " -}}
        {%- if attrname in ['placeholder', 'title'] -%}
            {{- attrname }}="{{ translation_domain is same as(false) ? attrvalue : attrvalue|trans({}, translation_domain) }}"
        {%- elseif attrvalue is same as(true) -%}
            {{- attrname }}="{{ attrname }}"
        {%- elseif attrvalue is not same as(false) -%}
            {{- attrname }}="{{ attrvalue }}"
        {%- endif -%}
    {%- endfor -%}
{%- endblock attributes -%}


