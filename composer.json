{
    "name": "uvoelkel/serverside-datatables-bundle",
    "type": "library",
    "description": "DataTables integration for Symfony",
    "keywords": [
        "DataTables"
    ],
    "homepage": "https://github.com/uvoelkel",
    "license": "MIT",
    "authors": [
        {
            "name": "Ulrich Völkel",
            "email": "mail@ulrich-voelkel.de"
        }
    ],
    "require": {
        "php": ">=8.0.0",
        "symfony/dependency-injection": "~7.0|~8.0"
    },
    "require-dev": {
        "symfony/framework-bundle": "~7.0|~8.0",
        "doctrine/doctrine-bundle": "~2.0|~3.0",

        "phpunit/phpunit": ">=9.0"
    },
    "config": {
        "bin-dir": "bin"
    },
    "autoload": {
        "psr-4": { "Voelkel\\DataTablesBundle\\": "" }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "8.0-dev"
        }
    }
}
